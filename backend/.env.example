# Google Places API (New) key — restrict it to "Places API (New)" in Google Cloud console
GOOGLE_API_KEY=
# gstinapi.in key (x-api-key)
GSTIN_API_KEY=
# simulated = OTP delivered to the on-page virtual phone (demo). live = real SMS provider (not configured)
OTP_MODE=simulated
# simulated = GST-registered mobile read from fixtures/demo_contacts.json for non-sandbox GSTINs
# live = call gstinapi.in /v1/gstin/{gstin}/contact (paid accounts only)
GST_CONTACT_MODE=simulated
